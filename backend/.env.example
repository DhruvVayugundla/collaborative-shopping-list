PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
NODE_ENV=development

# Optional: enables AI quick-add (get a key at https://console.groq.com/keys)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: hosted Turso database (used in production; leave unset locally)
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=...
